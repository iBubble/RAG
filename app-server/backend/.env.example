OLLAMA_BASE_URL="http://localhost:11434"
CHROMA_DB_PATH="./chroma_db"
FRONTEND_URL="http://localhost:8008"
ALLOW_ORIGINS="http://localhost:8008,https://rag.syhsgis.com"

# ─── 安全凭据（部署时必须修改）───
JWT_SECRET="CHANGE_ME_use_openssl_rand_hex_32"
ADMIN_INIT_PASSWORD="CHANGE_ME_admin_initial_password"
REDIS_PASSWORD="CHANGE_ME_redis_password"
NEO4J_PASSWORD="CHANGE_ME_neo4j_password"
QDRANT_URL="http://genrag-database:6333"
REDIS_URL="redis://:CHANGE_ME_redis_password@genrag-redis:6379/0"
NEO4J_URI="bolt://genrag-graphdb:7687"

# ─── Langfuse 可观测性（部署时配置）───
LANGFUSE_PUBLIC_KEY="CHANGE_ME_langfuse_public_key"
LANGFUSE_SECRET_KEY="CHANGE_ME_langfuse_secret_key"
LANGFUSE_HOST="http://langfuse:3000"
NEXTAUTH_SECRET="CHANGE_ME_must_be_at_least_32_chars_long"
ENCRYPTION_KEY="CHANGE_ME_64_char_hex_encryption_key"
SALT="CHANGE_ME_unique_salt_string"

# ─── PostgreSQL (Langfuse DB) ───
POSTGRES_PASSWORD="CHANGE_ME_postgres_password"

# ─── Docker 容器 root 密码（构建时通过 --build-arg 传入）───
ROOT_PASSWORD="CHANGE_ME_strong_root_password"
